# Copy to .env (next to config.yaml) and fill in. .env is gitignored; never commit it.
# Leave a key empty if you don't use that provider.

# Claude calls (preshot, opener, closer) when a persona's provider is anthropic.
ANTHROPIC_API_KEY=

# GPT models and the OpenAI voices (tts.provider: openai). Not needed with Claude + Kokoro voices.
OPENAI_API_KEY=

# Google's Chirp 3 HD voices (tts.provider: google): an API key restricted to the Cloud
# Text-to-Speech API, from a project with billing on (docs/booth.md, "Choosing a setup").
GOOGLE_TTS_API_KEY=

# The Jev minimap hazard read (minimap.provider: jev), from https://typesafe.ai.
TYPESAFE_API_KEY=

# Live handicaps from Squabbit (squabbit.enabled: true). Read-only sign-in as the league organiser.
SQUABBIT_EMAIL=
SQUABBIT_PASSWORD=

# Uploading the stats page (publish.enabled: true): the upload-only user's access key, from
# docs/tracking.md#sharing-the-stats-page.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phone pushes for booth health issues (notify.provider: ntfy). The ntfy topic you subscribed to in
# the ntfy app; make it long and random, since anyone who knows it can read the pushes.
NTFY_TOPIC=
